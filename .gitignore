# LIORA Portfolio - Git Ignore Configuration
# This file ensures sensitive files are not committed to the public repository

# Local Build & Dev
node_modules/
dist/
build/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# VS Code
.vscode/
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json

# IDE
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment Variables & Secrets
.env
.env.local
.env.*.local
secrets/
*.key
*.pem
*.crt

# Build artifacts
*.min.js
*.min.css
*.zip
*.tar.gz

# OS files
.DS_Store
Thumbs.db

# Cache
.cache/
.next/
out/

# Dependencies
node_modules/
package-lock.json
yarn.lock

# Local testing
test-results/
coverage/

# APK signing keys (if ever used locally)
*.keystore
*.jks
signing/

# Never commit credentials or private data
.credentials
credentials.json
private-data/

# GitHub Actions artifacts
.github/workflows/*.log

# Temporary files
.tmp
temp/
